
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  role         Role     @default(STUDENT)
  isActive     Boolean  @default(true)

  // Personal and profile details
  name         String?
  phone        String?
  gender       String?
  dateOfBirth  DateTime?
  city         String?
  state        String?
  pincode      String?

  // Student academic details
  rollNumber   String?  @unique
  branch       String?
  year         String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  applications Application[]
}

model Company {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  website         String?
  industry        String?
  location        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  placementDrives PlacementDrive[]
}

model PlacementDrive {
  id                  Int           @id @default(autoincrement())
  role                String
  package             Float
  eligibilityCriteria String
  deadline            DateTime
  status              String        @default("OPEN")
  companyId           Int
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  applications        Application[]
  company             Company       @relation(fields: [companyId], references: [id])
}

model Application {
  id               Int            @id @default(autoincrement())
  userId           Int
  placementDriveId Int
  status           String         @default("APPLIED")
  appliedAt        DateTime       @default(now())
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user             User           @relation(fields: [userId], references: [id])
  placementDrive   PlacementDrive @relation(fields: [placementDriveId], references: [id])

  // A user can apply only once to each placement drive
  @@unique([userId, placementDriveId])
}

enum Role {
  ADMIN
  STUDENT
  PLACEMENT_COORDINATOR
  RECRUITER
}
